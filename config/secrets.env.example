# Copy this file to config/secrets.env and fill in the real values.
# config/secrets.env is listed in .gitignore -- it must NEVER be
# committed, and never pasted into a chat or anywhere else.
#
# Loaded automatically by:
#   - refresh_lqas_lookup.py and _env_loader.py (Python steps)
#   - R/06_push_to_sharepoint.R and R/utils/env_loader.R (R steps)
# A variable already set in your real shell environment (via `setx` /
# `export`) always takes priority over this file.

# poliogo.afro.who.int (GPEI) API token -- used by
# refresh_lqas_lookup.py to fetch data/lookup/lqas_lookup.xlsx
# directly from the site's own REST API. Get this from
# https://poliogo.afro.who.int/dashboard/api/apitoken while logged in
# (the site's login page requires WHO SSO, so this token is the only
# way to fetch data non-interactively). Treat it exactly like a
# password. The same token already used for the im_workflow and
# AFRO-SIA-Dashboard-input projects works here too.
GPEI_API_TOKEN=

# Microsoft Graph app registration -- used by
# R/06_push_to_sharepoint.R to push data/final/afro_lqas_repositorty.csv
# to the WHO AF-pep/GISWORKSPACE SharePoint site's Data Repository
# folder (no browser login, no MFA -- this authenticates as a
# registered application, not as you). This is the SAME app
# registration the im_workflow and AFRO-SIA-Dashboard-input projects
# already use for that same site -- copy the three values from either
# of those projects' own config/secrets.env (never share or paste them
# anywhere else).
#
# SECURITY NOTE: these three values used to be hardcoded in plain text
# in R/sharepoint_connection.r, which is tracked in this repo's git
# history (35+ commits, pushed to
# https://github.com/Go-toure/Posit-LQAS-Workflow). If that app
# registration's client secret hasn't already been rotated since, do
# that in Azure AD app registrations before relying on this file, and
# use the new value below.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# ONA / WHONgHub API token -- used by fetch_ona_data.py.
#
# SECURITY NOTE: this token is currently also hardcoded as a fallback
# default value in both config/config.yml and fetch_ona_data.py itself
# (both tracked in git). Consider rotating it too, and removing the
# hardcoded fallback from those two files once this is filled in here.
ONA_API_TOKEN=
